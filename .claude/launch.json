{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.dashboard.config.js",
        "--host",
        "localhost",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--watch", "server/index.js"],
      "port": 3001
    },
    {
      "name": "api-debug",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/index.js"],
      "env": { "LOG_LEVEL": "debug" },
      "port": 3001
    },
    {
      "name": "api-limit2",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/index.js"],
      "env": { "LOG_LEVEL": "debug", "GENERATE_LIMIT_PER_HOUR": "2" },
      "port": 3001
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--config",
        "vite.dashboard.config.js",
        "--host",
        "localhost",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
