{
  "manifest_version": 3,
  "name": "Onextap",
  "version": "1.0.4",
  "description": "Autofill job applications.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://www.onextap.com/*",
    "https://onextap.com/*",
    "http://localhost:5173/*",
    "http://localhost:3001/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://www.onextap.com/*",
      "https://onextap.com/*",
      "http://localhost:5173/*"
    ]
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}